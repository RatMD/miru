{
    "name": "@rat.md/miru",
    "version": "0.1.0",
    "description": "MIRU \u2014 reusable Vue 3 components, forms and application UI.",
    "type": "module",
    "license": "MIT",
    "author": "rat.md",
    "homepage": "https://miru.at",
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "**/*.css"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        "./layouts": {
            "types": "./dist/layouts/index.d.ts",
            "import": "./dist/layouts.js"
        },
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./style.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/style.css"
        },
        "./package.json": "./package.json",
        "./miru": {
            "types": "./dist/miru.d.ts",
            "import": "./dist/miru.js"
        },
        "./composables": {
            "types": "./dist/composables/index.d.ts",
            "import": "./dist/composables.js"
        },
        "./composables/*": {
            "types": "./dist/composables/*.d.ts",
            "import": "./dist/composables/*.js"
        },
        "./support": {
            "types": "./dist/support/index.d.ts",
            "import": "./dist/support.js"
        },
        "./support/*": {
            "types": "./dist/support/*.d.ts",
            "import": "./dist/support/*.js"
        },
        "./plugins": {
            "types": "./dist/plugins/index.d.ts",
            "import": "./dist/plugins.js"
        },
        "./plugins/*": {
            "types": "./dist/plugins/*.d.ts",
            "import": "./dist/plugins/*.js"
        },
        "./adapters/ajax": {
            "types": "./dist/adapters/ajax.d.ts",
            "import": "./dist/adapters/ajax.js"
        },
        "./adapters/adonis": {
            "types": "./dist/adapters/adonis.d.ts",
            "import": "./dist/adapters/adonis.js"
        },
        "./adapters/laravel": {
            "types": "./dist/adapters/laravel.d.ts",
            "import": "./dist/adapters/laravel.js"
        },
        "./adapters/inertia": {
            "types": "./dist/adapters/inertia.d.ts",
            "import": "./dist/adapters/inertia.js"
        },
        "./themes/original.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/original.css"
        },
        "./themes/modern.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/modern.css"
        },
        "./themes/northern-lights.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/northern-lights.css"
        },
        "./themes/lagoon.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/lagoon.css"
        },
        "./themes/rosewood.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/rosewood.css"
        },
        "./themes/golden-hour.css": {
            "types": "./dist/style.d.ts",
            "default": "./dist/themes/golden-hour.css"
        }
    },
    "scripts": {
        "browser:install": "playwright install chromium",
        "build": "npm run typecheck && vite build && vue-tsc -p tsconfig.build.json && node scripts/copy-theme-styles.mjs",
        "build:watch": "vite build --watch",
        "check:package": "npm run build && node scripts/check-package.mjs",
        "dev": "npm run storybook:dev",
        "format": "prettier --check .",
        "format:fix": "prettier --write .",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix --max-warnings 0",
        "prepare": "node scripts/install-hooks.mjs && npm run build",
        "storybook:build": "storybook build",
        "storybook:dev": "storybook dev -p 6008",
        "storybook:test": "vitest run --project=storybook",
        "storybook:test:coverage": "vitest run --project=storybook --coverage",
        "storybook:test:watch": "vitest --project=storybook",
        "test": "npm run check:package && tsc -p tests/tsconfig.json && vue-tsc --noEmit -p tests/tsconfig.directives.json && vitest run && npm run storybook:build",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "check": "npm run lint && npm test"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.4",
        "@tabler/icons-vue": "^3.52.0",
        "@tanstack/vue-form": "^1.33.5",
        "@tanstack/vue-table": "^9.3.1",
        "@vueuse/core": "^15.1.0",
        "apexcharts": "^8.9.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.23",
        "embla-carousel": "9.0.0-rc04",
        "embla-carousel-accessibility": "9.0.0-rc04",
        "embla-carousel-auto-height": "9.0.0-rc04",
        "embla-carousel-auto-scroll": "9.0.0-rc04",
        "embla-carousel-autoplay": "9.0.0-rc04",
        "embla-carousel-fade": "9.0.0-rc04",
        "embla-carousel-vue": "9.0.0-rc04",
        "prettier": "^3.10.1",
        "reka-ui": "^2.11.0",
        "sortablejs": "^1.15.7",
        "tailwind-merge": "^3.7.1",
        "tinymce": "^8.10.2",
        "tw-animate-css": "^1.4.0",
        "vue3-apexcharts": "^1.11.3",
        "zod": "^4.6.7"
    },
    "peerDependencies": {
        "vue": "^3.5.45"
    },
    "devDependencies": {
        "@inertiajs/core": "^3.11.0",
        "@inertiajs/vue3": "^3.11.0",
        "@storybook/addon-a11y": "10.6.8",
        "@storybook/addon-docs": "10.6.8",
        "@storybook/addon-themes": "10.6.8",
        "@storybook/addon-vitest": "10.6.8",
        "@storybook/vue3-vite": "10.6.8",
        "@tailwindcss/vite": "4.3.5",
        "@types/node": "^24.19.2",
        "@types/sortablejs": "^1.15.9",
        "@vitejs/plugin-vue": "6.0.11",
        "@vitest/browser-playwright": "5.1.1",
        "@vitest/coverage-v8": "5.1.1",
        "@vue/eslint-config-typescript": "^14.9.0",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import-x": "^4.18.1",
        "eslint-plugin-storybook": "10.6.8",
        "eslint-plugin-vue": "^10.12.1",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "playwright": "1.65.1",
        "storybook": "10.6.8",
        "tailwindcss": "4.3.5",
        "typescript": "6.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1",
        "vue": "3.5.45",
        "vue-component-meta": "3.3.14",
        "vue-tsc": "3.3.14"
    }
}
